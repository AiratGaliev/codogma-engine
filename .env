# Codogma Engine — launch config for new SolidJS Editor Host
# See docs/editor-ui-migration.md, docs/decisions/ADR-0005-solidjs-editor-host.md

# --- Backend (Node server) ---
PORT=3000
PROJECT_DIR=tests/workspace/test-typescript
EDITOR_DIR=source/editor
DEV_MODE=

# --- New SolidJS Editor Host (Vite) ---
VITE_PORT=5173

# --- Security / Proxy ---
CODOGMA_ALLOWED_ORIGINS=http://127.0.0.1:5173
CODOGMA_ALLOWED_HOSTS=127.0.0.1

# --- MCP ---
CODOGMA_MCP_URL=http://127.0.0.1:3000/editor/mcp
MCP_BRIDGE_PORT=1902
MCP_BRIDGE_HOST=127.0.0.1

# --- Optional AI Chat ---
AI_CHAT_SERVICE=http://127.0.0.1:3031
