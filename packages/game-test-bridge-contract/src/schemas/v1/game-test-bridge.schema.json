    "EventReadRequest": {
      "type": "object",
      "required": [
        "testSessionId",
        "cursor",
        "limit"
      ],
      "properties": {
        "testSessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "eventTypes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/EventTypeId"
          }
        },
        "entityRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OpaqueReference"
          }
        }
      },
      "additionalProperties": false
    },
    "SequenceGap": {
      "type": "object",
      "required": [
        "fromSequence",
        "toSequence",
        "reason"
      ],
      "properties": {
        "fromSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "buffer-overflow",
            "retention",
            "source-gap"
          ]
        }
      },
      "additionalProperties": false
    },
    "BufferOverflowDiagnostic": {
      "type": "object",
      "required": [
        "occurred",
        "capacity",
        "droppedEventCount"
      ],
      "properties": {
        "occurred": {
          "type": "boolean"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "droppedEventCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "EventStreamIntegrity": {
      "type": "object",
      "required": [
        "coverage",
        "sequenceGaps",
        "bufferOverflow",
        "lostEventCount"
      ],
      "properties": {
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "sequenceGaps": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/SequenceGap"
          }
        },
        "bufferOverflow": {
          "$ref": "#/$defs/BufferOverflowDiagnostic"
        },
        "lostEventCount": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "EventPage": {
      "type": "object",
      "required": [
        "kind",
        "testSessionId",
        "requestCursor",
        "nextCursor",
        "hasMore",
        "events",
        "integrity"
      ],
      "properties": {
        "kind": {
          "const": "game-test-bridge.event-page"
        },
        "testSessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "requestCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "hasMore": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/GameTestEvent"
          }
        },
        "integrity": {
          "$ref": "#/$defs/EventStreamIntegrity"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "additionalProperties": false
    },
    "TestActionDescriptor": {
      "type": "object",
      "required": [
        "actionId",
        "version",
        "description",
        "capabilityId",
        "effect",
        "allowedProfiles",
        "inputSchemaId",
        "outputSchemaId",
        "status"
      ],
      "properties": {
        "actionId": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capabilityId": {
          "$ref": "#/$defs/Identifier"
        },
        "effect": {
          "type": "string",
          "enum": [
            "observe",
            "controlled-state-change"
          ]
        },
        "allowedProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "development",
              "test"
            ]
          }
        },
        "inputSchemaId": {
          "$ref": "#/$defs/Identifier"
        },
        "outputSchemaId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "$ref": "#/$defs/UnsupportedCapabilityReason"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "reason": {
                "$ref": "#/$defs/UnsupportedCapabilityReason"
              }
            },
            "required": [
              "reason"
            ]
          },
          "else": {
            "type": "object",
            "properties": {
              "reason": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "controlled-state-change"
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "properties": {
              "allowedProfiles": {
                "const": [
                  "test"
                ]
              }
            },
            "type": "object"
          }
        }
      ],
      "additionalProperties": false
    },
    "TestActionRequest": {
      "type": "object",
      "required": [
        "kind",
        "requestId",
        "testSessionId",
        "actionId",
        "actionVersion",
        "input"
      ],
      "properties": {
        "kind": {
          "const": "game-test-bridge.action-request"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "testSessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "actionId": {
          "$ref": "#/$defs/Identifier"
        },
        "actionVersion": {
          "$ref": "#/$defs/ContractVersion"
        },
        "input": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "additionalProperties": false
    },
    "TestActionFailure": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "diagnostics"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ACTION_NOT_REGISTERED",
            "ACTION_VERSION_MISMATCH",
            "CAPABILITY_NOT_DECLARED",
            "CAPABILITY_UNAVAILABLE",
            "PROFILE_NOT_ALLOWED",
            "INPUT_VALIDATION_FAILED",
            "EXECUTION_FAILED",
            "TIMEOUT",
            "CANCELLED",
            "POLICY_RESTRICTED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/BridgeDiagnostic"
          }
        }
      },
      "additionalProperties": false
    },
    "TestActionSuccess": {
      "type": "object",
      "required": [
        "kind",
        "requestId",
        "status",
        "completedAt",
        "output"
      ],
      "properties": {
        "kind": {
          "const": "game-test-bridge.action-result"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "const": "succeeded"
        },
        "completedAt": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "additionalProperties": false
    },
    "TestActionRejectedOrFailed": {
      "type": "object",
      "required": [
        "kind",
        "requestId",
        "status",
        "completedAt",
        "failure"
      ],
      "properties": {
        "kind": {
          "const": "game-test-bridge.action-result"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "rejected",
            "failed"
          ]
        },
        "completedAt": {
          "type": "number",
          "minimum": 0
        },
        "failure": {
          "$ref": "#/$defs/TestActionFailure"
        }
      },
      "additionalProperties": false
    },
    "TestActionResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/TestActionSuccess"
        },
        {
          "$ref": "#/$defs/TestActionRejectedOrFailed"
        }
      ]
    }
  }
}
