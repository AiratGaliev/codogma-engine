{
  "name": "@codogma/editor-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone stdio MCP server for Codogma Engine editor tools.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "codogma-editor-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "6.0.3"
  }
}
