        {
          "type": "text",
          "id": "cg-01427",
          "x": 28,
          "y": 744,
          "name": "Workbench implementation notes",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width-height",
          "width": 1384,
          "height": 46,
          "content": "Docking: native layout primitives + explicit resizable splitters; evaluate a library only after proven workflows. Persist tabs, visibility, layout and theme as UI state. Panel lifecycle is explicit; commands resolve the current focus/context owner.",
          "lineHeight": 1.2,
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cg-01428",
          "x": 28,
          "y": 806,
          "name": "Shortcut contract",
          "fill": "$accent-selection",
          "textGrowth": "fixed-width-height",
          "width": 1384,
          "height": 18,
          "content": "Ctrl+S Save · Ctrl+Z Undo · Ctrl+Shift+Z Redo · Ctrl+P Palette · F2 Rename · Del Remove · W Move · E Rotate · R Scale (only outside editable fields).",
          "lineHeight": 1.08,
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "cg-01429",
          "x": 28,
          "y": 850,
          "name": "Acceptance viewport targets",
          "fill": "$text-disabled",
          "textGrowth": "fixed-width-height",
          "width": 1384,
          "height": 18,
          "content": "Primary 1440 × 900 · Compact 1280 × 720: collapse secondary bottom panes to tabs; preserve readable controls and central Scene view.",
          "lineHeight": 1.08,
          "fontFamily": "Inter",
          "fontSize": 8,
          "fontWeight": "500"
        }
      ]
    },
