{
  "name": "@codogma/editor-host",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codogma Engine SolidJS Editor Host",
  "scripts": {
    "build:core": "tsc -p ../../packages/cge/tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "predev": "npm run build:core",
    "typecheck": "npm run build:core && tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "pretest": "npm run build:core",
    "test": "vitest run",
    "test:browser": "playwright test",
    "pretest:watch": "npm run build:core",
    "test:watch": "vitest"
  },
  "dependencies": {
    "solid-js": "1.9.16",
    "@codogma/cge": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "@types/node": "22.19.15",
    "vitest": "5.0.5"
  }
}
