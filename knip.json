{
    "$schema": "./node_modules/knip/schema.json",
    "workspaces": {
        ".": {
            "entry": ["mini-services/ai-chat/index.mjs"],
            "project": ["server/**/*.mjs", "mini-services/**/*.mjs", "tests/*.mjs"],
            "ignoreDependencies": ["z-ai-web-dev-sdk"],
            "ignoreExportsUsedInFile": true
        },
        "src/editor": {
            "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts", "browser-tests/**/*.ts"]
        },
        "packages/cge": {
            "project": ["src/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.mjs"]
        },
        "packages/editor-mcp-server": {
            "project": ["src/**/*.ts", "tests/**/*.mjs"]
        },
        "packages/game-test-bridge-contract": {
            "project": ["src/**/*.ts", "tests/**/*.ts"]
        },
        "packages/localization": {
            "project": ["src/**/*.ts", "bin/**/*.mjs", "tests/**/*.mjs"]
        }
    }
}
