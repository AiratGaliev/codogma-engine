{
  "name": "codogma-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Codogma Engine — native 2D HTML5 game engine with a SolidJS Editor Host and Phaser 4.2.1 runtime integration",
  "scripts": {
    "dev": "node server/server.mjs 2>&1 | tee dev.log",
    "dev:proxy": "CODOGMA_ALLOWED_HOSTS='*' CODOGMA_ALLOWED_ORIGINS=\"${CODOGMA_ALLOWED_ORIGINS:-*}\" node server/server.mjs 2>&1 | tee dev.log",
    "start": "node server/server.mjs",
    "mcp": "node server/mcp-launcher.mjs",
    "build": "npm run build:editor-host",
    "build:localization": "cd packages/localization && npm run build",
    "build:mcp": "npm --prefix packages/editor-mcp-server run build",
    "test:mcp-package": "npm --prefix packages/editor-mcp-server test",
    "watch": "npm run dev:editor-host",
    "test:e2e": "node tests/mcp-e2e-test.mjs node server/mcp-launcher.mjs",
    "test:security": "node tests/security-smoke-test.mjs",
    "test:localization": "cd packages/localization && npm test",
    "test:localization:project": "npm run build:localization && node packages/localization/bin/validate-localization.mjs tests/workspace/test-typescript --fallback en-US",
    "test:localization:acceptance": "npm run build:localization && node tests/localization-acceptance.mjs",
    "test:mini-services": "node tests/mini-services-security-test.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:all": "npm run test:unit && npm run test:security && npm run test:mini-services && npm run test:localization && npm run test:localization:project && npm run test:localization:acceptance && npm run test:mcp-package && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise server mini-services tests --config .dependency-cruiser.cjs",
    "knip": "knip",
    "dev:editor-host": "node scripts/dev-editor-host.mjs",
    "build:editor-host": "npm --prefix src/editor run build",
    "test:editor-host": "npm --prefix src/editor run test",
    "test:editor-host:browser": "npm --prefix src/editor run test:browser"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.5.0",
    "@codogma/localization": "file:packages/localization"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
