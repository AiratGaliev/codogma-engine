{
  "name": "codogma-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Codogma Engine — native 2D HTML5 game engine with a SolidJS Editor Host and Phaser 4.2.1 runtime integration",
  "scripts": {
    "dev": "node server/server.mjs 2>&1 | tee dev.log",
    "start": "node server/server.mjs",
    "mcp": "node server/mcp-launcher.mjs",
    "build": "npm run build:editor-host",
    "build:localization": "npm run build --workspace=@codogma/localization",
    "build:mcp": "npm run build --workspace=@codogma/editor-mcp-server",
    "test:mcp-package": "npm test --workspace=@codogma/editor-mcp-server",
    "watch": "npm run dev:editor-host",
    "test:e2e": "node tests/mcp-e2e-test.mjs node server/mcp-launcher.mjs",
    "test:security": "node tests/security-smoke-test.mjs",
    "test:localization": "npm test --workspace=@codogma/localization",
    "test:localization:project": "npm run build:localization && node packages/localization/bin/validate-localization.mjs packages/localization/tests/fixtures/sample-project --fallback en-US",
    "test:localization:acceptance": "npm run build:localization && node tests/localization-acceptance.mjs",
    "test:mini-services": "node tests/mini-services-security-test.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:all": "npm run test:unit && npm run test:security && npm run test:mini-services && npm run test:localization && npm run test:localization:project && npm run test:localization:acceptance && npm run test:cge && npm run test:game-test-bridge-contract && npm run test:mcp-package && npm run test:workspace-consumer && npm run test:editor-host && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise server mini-services tests --config .dependency-cruiser.cjs",
    "knip": "knip",
    "dev:editor-host": "node scripts/dev-editor-host.mjs",
    "build:editor-host": "npm run build --workspace=@codogma/editor-host",
    "test:editor-host": "npm test --workspace=@codogma/editor-host",
    "test:editor-host:browser": "npm run test:browser --workspace=@codogma/editor-host",
    "build:cge": "npm run build --workspace=@codogma/cge",
    "build:game-test-bridge-contract": "npm run build --workspace=@codogma/game-test-bridge-contract",
    "test:cge": "npm run quality:check --workspace=@codogma/cge",
    "test:game-test-bridge-contract": "npm run quality:check --workspace=@codogma/game-test-bridge-contract",
    "test:localization:report": "npm run quality:report --workspace=@codogma/localization",
    "test:workspace-consumer": "npm run build:cge && npm run build:localization && npm run build:mcp && npm run build:game-test-bridge-contract && node tests/workspace/consumer/smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.5.0",
    "@codogma/localization": "0.1.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "workspaces": [
    "packages/*",
    "src/editor"
  ],
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.21.2 <12"
  }
}
