        {
          "type": "text",
          "id": "cg-01427",
          "name": "Workbench implementation notes",
          "x": 28,
          "y": 744,
          "width": 1384,
          "height": 46,
          "content": "Docking: CSS Grid / Flex splitters; panel min/max widths; explicit active tab per dock region; drag only panel headers; persist layout, visibility, open tabs and theme separately from project data. Context menus are anchored to the invoking panel and expose only supported actions.",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "400",
          "lineHeight": 1.2,
          "fill": "#A7B0BE"
        },
        {
          "type": "text",
          "id": "cg-01428",
          "name": "Shortcut contract",
          "x": 28,
          "y": 806,
          "width": 1384,
          "height": 18,
          "content": "Ctrl+S Save  ·  Ctrl+Z Undo  ·  Ctrl+Shift+Z Redo  ·  Ctrl+P Command Palette  ·  F2 Rename  ·  Delete Remove  ·  W Move  ·  E Rotate  ·  R Scale (only when focus is not in an editable input)",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "600",
          "lineHeight": 1.08,
          "fill": "#9298FF"
        },
        {
          "type": "text",
          "id": "cg-01429",
          "name": "Acceptance viewport targets",
          "x": 28,
          "y": 850,
          "width": 1384,
          "height": 18,
          "content": "Primary: 1440 × 900  ·  Compact: 1280 × 720 (collapse the secondary bottom dock to tabs; keep Scene central; do not reduce inspector controls below readable widths).",
          "textGrowth": "fixed-width-height",
