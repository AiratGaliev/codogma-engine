          "name": "Migration constraint summary",
          "x": 28,
          "y": 872,
          "width": 1384,
          "height": 15,
          "content": "SolidJS Host + legacy Colibri · one backend and one writer per project · keep MCP registry unchanged; route MCP SSE by session before multiple UI subscribers · Tauri is a later shell step.",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "400",
          "lineHeight": 1.08,
          "fill": "#A7B0BE"
        }
      ],
