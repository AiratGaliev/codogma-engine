        {
          "type": "text",
          "id": "cg-01427",
          "name": "Workbench implementation notes",
          "x": 28,
          "y": 744,
          "width": 1384,
          "height": 46,
          "content": "Docking: native layout primitives + explicit resizable splitters; evaluate a library only after proven workflows. Persist tabs, visibility, layout and theme as UI state. Panel lifecycle is explicit; commands resolve the current focus/context owner.",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "400",
          "lineHeight": 1.2,
          "fill": "#A7B0BE"
        },
        {
          "type": "text",
          "id": "cg-01428",
          "name": "Shortcut contract",
          "x": 28,
          "y": 806,
          "width": 1384,
          "height": 18,
          "content": "Ctrl+S Save · Ctrl+Z Undo · Ctrl+Shift+Z Redo · Ctrl+P Palette · F2 Rename · Del Remove · W Move · E Rotate · R Scale (only outside editable fields).",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "600",
          "lineHeight": 1.08,
          "fill": "#9298FF"
        },
        {
          "type": "text",
          "id": "cg-01429",
          "name": "Acceptance viewport targets",
          "x": 28,
          "y": 850,
          "width": 1384,
          "height": 18,
          "content": "Primary 1440 × 900 · Compact 1280 × 720: collapse secondary bottom panes to tabs; preserve readable controls and central Scene view.",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 8,
          "fontWeight": "500",
          "lineHeight": 1.08,
          "fill": "#748091"
        },
        {
          "type": "text",
          "id": "cg-01509",
          "name": "Context item 5",
          "x": 28,
          "y": 556,
          "width": 225,
          "height": 14,
          "content": "Group Selection  Ctrl + G",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "400",
          "lineHeight": 1.08,
          "fill": "#E7EBF2"
        },
        {
          "type": "text",
          "id": "cg-01900",
          "name": "Context item 6",
          "x": 28,
          "y": 576,
          "width": 225,
          "height": 14,
          "content": "Prefab Overrides…",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "500",
          "lineHeight": 1.08,
          "fill": "#E7EBF2"
        }
      ],
      "clip": true,
      "metadata": {
        "type": "codogma-workspace-state",
        "purpose": "Timeline UX proposal, keyboard-driven command palette and contextual menus; demo content is explicitly non-runtime."
      },
      "theme": {
        "mode": "dark"
      }
    },
