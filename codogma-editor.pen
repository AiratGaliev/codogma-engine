        {
          "type": "text",
          "id": "cg-00147",
          "name": "Icon source rule",
          "x": 28,
          "y": 651,
          "width": 1384,
          "height": 34,
          "content": "Object / resource icons: original Godot Editor SVGs from source/editor/plugins/phasereditor2d.resources/icons/{dark,light}/godot. Keep both theme directories and GODOT-ICONS-LICENSE.txt. General command icons may use one consistent Lucide set; never use emoji or Codicons.",
          "textGrowth": "fixed-width-height",
          "fontFamily": "Inter",
          "fontSize": 9,
          "fontWeight": "400",
          "lineHeight": 1.08,
          "fill": "#A7B0BE"
        },
